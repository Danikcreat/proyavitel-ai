# Loaded from the project root after the root .env. Never commit ai-service/.env.
AI_PROVIDER=aiai
AI_GENERATION_REQUESTS_PER_MINUTE=20
AI_GENERATION_REQUESTS_PER_DAY=200
AI_MAX_CONCURRENT_GENERATIONS_PER_USER=2
AI_GLOBAL_GENERATION_REQUESTS_PER_MINUTE=60
AI_GLOBAL_GENERATION_REQUESTS_PER_DAY=1000
AI_GLOBAL_MAX_CONCURRENT_GENERATIONS=8
# Public documentation: https://aiai.by/docs lists this endpoint.
AI_BASE_URL=https://api.aiai.by/v1
# The supplied https://vedai.by/api/v1 can be set explicitly if confirmed in your account.
# Leave empty until scripts/check_llm.py --list confirms the exact model ID.
# Requested candidate: deepseek-v4-flash (not confirmed).
# Documented newer model: deepseek-v4.1-flash (do not substitute without choosing it).
AI_MODEL=
AIAI_API_KEY=
# Fast interactive answers; DeepSeek reasoning is disabled explicitly.
AI_LLM_THINKING=disabled
AI_LLM_MAX_TOKENS=1024
# Keep the running demo intact until credentials and platform JWT are configured.
# AI_MODE=llm

