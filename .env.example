# scripts/init_demo.py creates .env and replaces these two placeholders.
POSTGRES_PASSWORD=GENERATE_PASSWORD
AI_DEMO_JWT_SECRET=GENERATE_SECRET
AI_MODE=demo
AI_AUTH_MODE=demo
AI_DEMO_UI_ENABLED=true
AI_JWT_ISSUER=pulse
AI_JWT_AUDIENCE=pulse-ai
AI_DATABASE_URL=sqlite+aiosqlite:///./proyavitel.db
AI_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Production integration (disable demo auth):
# AI_AUTH_MODE=jwt
# AI_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
# OR AI_JWT_JWKS_URL=https://trusted-platform.example/.well-known/jwks.json
# AI_PLATFORM_BASE_URL=http://platform:8080

# Optional real model, requires jwt auth; no external calls in demo mode.
# AI_MODE=llm
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_LLM_MODEL=<model supporting Chat Completions>
# AI_LLM_API_KEY=<provider API key>

AI_GENERATION_REQUESTS_PER_MINUTE=20
AI_GENERATION_REQUESTS_PER_DAY=200
AI_MAX_CONCURRENT_GENERATIONS_PER_USER=2
AI_GLOBAL_GENERATION_REQUESTS_PER_MINUTE=60
AI_GLOBAL_GENERATION_REQUESTS_PER_DAY=1000
AI_GLOBAL_MAX_CONCURRENT_GENERATIONS=8
